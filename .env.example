# Database (local dev uses SQLite by default; swap to Postgres for production)
DATABASE_URL="file:./dev.db"
# For production (e.g. Vercel Postgres / Neon / Supabase):
# DATABASE_URL="postgresql://user:password@host:5432/misskare?schema=public"

# --- Shopify (headless storefront) ---
# 1. In Shopify Admin: Settings -> Apps and sales channels -> Develop apps
#    (or the "Headless" channel) -> create a Storefront API access token.
# 2. Make sure "Storefront API" scopes include unauthenticated read/write for
#    products, collections, and carts/checkouts.
# 3. Products/collections must be published to the "Online Store" /
#    "Headless" sales channel to be visible via the Storefront API.
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN="iubizs-ay.myshopify.com"
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN="replace-with-your-storefront-access-token"
NEXT_PUBLIC_SHOPIFY_API_VERSION="2025-01"

# Auth
JWT_SECRET="replace-with-a-long-random-string"

# Stripe is no longer used for checkout now that Shopify is connected —
# Shopify's own hosted checkout (cart.checkoutUrl) handles payment.
# Left here only if you want to fall back to the local demo checkout.
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxxxxxx"

# App
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
